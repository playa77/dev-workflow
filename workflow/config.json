{
  "version": 2,
  "stack": [
    "python"
  ],
  "commands": {
    "test_full": "python3 -m unittest discover -s tests -t .",
    "test_affected": "python3 -m unittest discover -s tests -t .",
    "test_smoke": "python3 -m unittest discover -s tests -t .",
    "lint": "python3 -m compileall -q tests workflow",
    "build": "python3 -m compileall -q workflow",
    "integrity": "bash workflow/scripts/check-test-integrity.sh --verify",
    "callers": "python3 workflow/scripts/check-caller-existence.py --base main",
    "stats": "bash workflow/scripts/wp-stats.sh --base main"
  },
  "integrity": {
    "test_paths": [
      "tests/test_*.py"
    ],
    "count_cmd": ""
  },
  "mode": {
    "merge": "human",
    "review": "advisory",
    "questions_max": 12
  },
  "review": {
    "approvers": [],
    "status_context": "risk-gate"
  },
  "risk_triggers": {
    "security": [
      "**/auth/**",
      "**/authn/**",
      "**/authz/**",
      "**/crypto/**",
      "**/*secret*",
      "**/.env",
      "**/*.pem",
      "**/*.key"
    ],
    "data": [
      "**/migrations/**",
      "**/migrate/**",
      "**/schema/**"
    ],
    "money": [
      "**/billing/**",
      "**/payments/**",
      "**/money/**"
    ],
    "dependencies": [
      "**/pyproject.toml",
      "**/package.json",
      "**/requirements*.txt",
      "**/go.mod",
      "**/Cargo.toml",
      "**/*.lock",
      "**/poetry.lock",
      "**/package-lock.json",
      "**/yarn.lock"
    ],
    "ci": [
      ".github/**"
    ],
    "enforcement": [
      "workflow/scripts/**",
      "workflow/config.json",
      "workflow/state/test-baseline.json"
    ],
    "method": [
      "AGENTS.md",
      "workflow/**"
    ],
    "public_api": [
      "**/api/**",
      "**/public/**"
    ],
    "bookkeeping": [
      "DECISIONS.md",
      "CHANGELOG.md",
      "workflow/process/CALIBRATION.csv",
      "workflow/state/install.json"
    ]
  }
}
